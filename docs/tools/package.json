{
  "name": "vibelang-docs-tools",
  "private": true,
  "type": "module",
  "description": "Checks documentation and builds Markdown copies and llms.txt for vibelang.sh.",
  "scripts": {
    "check:snippets": "bun test first-run.test.ts && bun check-snippets.ts --run",
    "check:diagnostics": "bun check-diagnostic-docs.ts",
    "check:content": "bun check-smithers-content.ts",
    "check:tokens": "bun token-counts.ts --check",
    "test": "bun test",
    "check:release": "node release-docs.mjs --check"
  },
  "devDependencies": {
    "marked": "18.0.12",
    "@effect/platform-node": "4.0.6",
    "@effect/vitest": "4.0.6",
    "vitest": "5.0.5",
    "effect": "4.0.6",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-browser": "4.0.6",
    "js-tiktoken": "1.0.21"
  }
}
