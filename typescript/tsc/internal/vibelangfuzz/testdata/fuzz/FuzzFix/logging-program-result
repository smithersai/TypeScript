string("-- a.vibe --\nexport error NotFound { id: string }\n-- b.vibe --\nexport error NotFound { id: string }\n-- main.vibe --\n// expect-result: {\"sameName\":[\"A a\",\"timeout 5.0\",\"B b\"],\"sameNameIs\":[\"A a\",\"timeout\",\"B b\"],\"family\":[\"app /p\",\"other o\"],\"shape\":[\"circle\",\"square 2\",\"No match arm matched [object Object]\"],\"parity\":[\"even\",\"odd 3\",\"No match arm matched [object Object]\"],\"shapeOrCount\":[\"circle\",\"none\",\"some 4\",\"No match arm matched [object Object]\"],\"positions\":[[\"square 2\"],\"No match arm matched [object Object]\",\"square 2\",\"No match arm matched [object Object]\",\"logged\",\"No match arm matched [object Object]\"]}\n// A class pattern matches by class (D213, D215, D278), so D209's proof\n// follows the class, not the shape: two error classes that share a name and\n// fields stay distinct, a family's base covers its subclasses but not an\n// unrelated error with the same fields, and is narrows as instanceof does.\n// D294 keeps the last arm's tests of a match that tests a class or a custom\n// matcher, because a value's type does not prove what instanceof or a custom\n// matcher returns: a structural object of a class type, an instance that a\n// custom matcher refuses, and a structural object that passes a class arm to\n// reach an Option arm each throw the proposal's TypeError instead of taking\n// the last arm.\nimport * as A from \"./a.vibe\"\nimport * as B from \"./b.vibe\"\n\nerror Timeout { ms: number }\nerror AppError { _tag: string; code: string }\nerror Missing extends AppError { path: string }\nerror Other { code: string }\n\nclass Circle { readonly _tag = \"Circle\"; readonly r = 1 }\nclass Square { readonly _tag = \"Square\"; readonly side = 2 }\n\nclass Even {\n  readonly _tag = \"Even\"\n  constructor(readonly n: number) {}\n}\n\n// Only an instance with an odd n is an Odd.\nclass Odd {\n  readonly _tag = \"Odd\"\n  constructor(readonly n: number) {}\n  static [customMatcher](subject: unknown) {\n    return subject instanceof Odd && subject.n % 2 === 1\n  }\n}\n\ntype Failure = A.NotFound | B.NotFound | Timeout\n\nfunction sameName(e: Failure) {\n  return match (e) {\n    when A.NotFound: `A ${e.id}`;\n    when Timeout: `timeout ${e.ms.toFixed(1)}`;\n    when B.NotFound: `B ${e.id}`;\n  }\n}\n\nfunction sameNameIs(e: Failure) {\n  if (e is A.NotFound) return `A ${e.id}`\n  if (e is Timeout) return \"timeout\"\n  return `B ${e.id}`\n}\n\nfunction family(e: Missing | Other) {\n  return match (e) {\n    when AppError: `app ${e.path}`;\n    when Other: `other ${e.code}`;\n  }\n}\n\nfunction shape(s: Circle | Square) {\n  return match (s) {\n    when Circle: \"circle\";\n    when Square: `square ${s.side}`;\n  }\n}\n\nfunction parity(n: Even | Odd) {\n  return match (n) {\n    when Even: \"even\";\n    when Odd: `odd ${n.n}`;\n  }\n}\n\nfunction shapeOrCount(x: Circle | Option.Option<number>) {\n  return match (x) {\n    when Circle: \"circle\";\n    when Option.None: \"none\";\n    when Option.Some(let n): `some ${n}`;\n  }\n}\n\n// The last arm keeps its check in each position a match lowers to (D214):\n// a statement, inside an expression, and in an Effect function.\nfunction shapeStatement(s: Circle | Square, log: Array<string>) {\n  match (s) {\n    when Circle: log.push(\"circle\");\n    when Square: log.push(`square ${s.side}`);\n  }\n  return log\n}\n\nfunction shapeExpression(s: Circle | Square) {\n  const label = match (s) {\n    when Circle: \"circle\";\n    when Square: `square ${s.side}`;\n  }\n  return label\n}\n\nfunction shapeEffect(s: Circle | Square) {\n  match (s) {\n    when Circle: Effect.log(\"circle\");\n    when Square: Effect.log(`square ${s.side}`);\n  }\n  return \"logged\"\n}\n\n// The program's value, or the message of the defect it dies with.\nfunction settle<A>(program: A!!) {\n  return match (exit(program)) {\n    when Exit.Success(let value): value;\n    when Exit.Failure(let cause): (Cause.squash(cause) as Error).message;\n  }\n}\n\nexport function main() {\n  const circle: Circle = { _tag: \"Circle\", r: 1 }\n  return {\n    sameName: [sameName(new A.NotFound({ id: \"a\" })), sameName(new Timeout({ ms: 5 })), sameName(new B.NotFound({ id: \"b\" }))],\n    sameNameIs: [sameNameIs(new A.NotFound({ id: \"a\" })), sameNameIs(new Timeout({ ms: 5 })), sameNameIs(new B.NotFound({ id: \"b\" }))],\n    family: [family(new Missing({ code: \"m\", path: \"/p\" })), family(new Other({ code: \"o\" }))],\n    shape: [shape(new Circle()), shape(new Square()), settle(shape(circle))],\n    parity: [parity(new Even(2)), parity(new Odd(3)), settle(parity(new Odd(2)))],\n    shapeOrCount: [shapeOrCount(new Circle()), shapeOrCount(Option.none()), shapeOrCount(Option.some(4)), settle(shapeOrCount(circle))],\n    positions: [\n      shapeStatement(new Square(), []), settle(shapeStatement(circle, [])),\n      shapeExpression(new Square()), settle(shapeExpression(circle)),\n      shapeEffect(new Square()), settle(shapeEffect(circle))\n    ]\n  }\n}\n-- package.json --\n{\"type\":\"module\"}\n-- tsconfig.json --\n{\n  \"compilerOptions\": {\n    \"target\": \"es2022\",\n    \"lib\": [\"esnext\", \"dom\"],\n    \"module\": \"nodenext\",\n    \"moduleResolution\": \"nodenext\",\n    \"strict\": true,\n    \"types\": [],\n    \"skipLibCheck\": true,\n    \"outDir\": \"out\",\n    \"declaration\": true\n  },\n  \"include\": [\"*.vibe\"]\n}\n")
