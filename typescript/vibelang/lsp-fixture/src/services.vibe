// The prelude, a service, and a plain function. Effect and TaggedError need
// no import in a .vibe file. The long forms are deliberate here, so their
// EK4830 and EK4833 warnings are off for those lines (D241).
// @vibelang-diagnostics-next-line EK4830:off
export class Missing extends TaggedError("Missing")<{ readonly id: number }> {}

export abstract class Users {
  // @vibelang-diagnostics-next-line EK4833:off
  abstract find(id: number): Effect<string, Missing, never>
}

// No Effect operation and no failure: this compiles to plain JavaScript.
export function double(n: number) {
  return n * 2
}

export function greet(id: number) {
  const name = Users.find(id)
  return `${name} scored ${double(id)}`
}

service Greeter { greet(name: string): Effect<string> }
export function serviceGreeting() { return Greeter.greet("Ada") }

export function readFile(path: string) { return FileSystem.readFileString(path) }
export function processHostname() { return Experimental.Process.hostname() }
