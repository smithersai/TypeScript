error Missing

// A named function expression that calls itself forwards to its generator,
// as a declaration does; tracing still reports each call where it was made.
const leaf = function leaf(n: number): Effect<number, Missing> {
  yieldNow()
  if (n > 0) return leaf(n - 1)
  throw new Missing()
}

export function main() {
  yieldNow()
  return leaf(1)
}

export const counted = function counted(this: { value: number }, add: number, unused = 1): Effect<number[]> {
  yieldNow()
  if (add > 0) return counted.call(this, add - 1)
  return [this.value, arguments.length, unused]
}
