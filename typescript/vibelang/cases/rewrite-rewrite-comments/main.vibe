import "vibelang/platform/node"
class Bad extends Data.TaggedError("Bad")<{ readonly /* field explanation */ n: number }> {}
function value(): number!! {
  return Effect.succeed(/* keep this explanation */ 7)
}
function lineValue(): number!! {
  return Effect.succeed(
    // value explanation
    4
  )
}
function wrapperValue(): number!! {
  return Effect./* wrapper explanation */succeed(3)
}
function failed(): number!Bad {
  return Effect.fail(
    // failure explanation
    new Bad({ n: 5 })
  )
}
export function main() { Console.log(value(), new Bad({n:1}).n)
  Console.log(lineValue(), wrapperValue())
  Console.log(failed() catch (e) => e.n) }
