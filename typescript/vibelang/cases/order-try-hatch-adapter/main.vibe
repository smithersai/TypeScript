// expect-result: [[7,4],["mapper","input","mapper","input"]]
// A try hatch whose function may return a promise or a value goes through
// the runtime's adapter (D232), which takes the function, the mapper and the
// inputs in the order written; Effect's own try takes them in another order.
// Either way the arguments run in the order written (chapter 13).
error Bad { reason: unknown }

export function main() {
  const trace: string[] = []
  function makeMapper() {
    trace.push("mapper")
    return (reason: unknown): Bad => new Bad({ reason })
  }
  function input(value: number) {
    trace.push("input")
    return value
  }
  const adapted: number = try((x: number): number | Promise<number> => x > 5 ? x : Promise.resolve(x), makeMapper(), input(7))
  const effect: number = try((x: number) => x, makeMapper(), input(4))
  return [[adapted, effect], trace]
}
