// expect-result: {"method":[null,["getter"]],"receiver":[null,[]],"present":[7,["argument"]]}
// An optional call skips its arguments when its function or its receiver is
// absent (chapter 13), also when the function has expected failures and an
// argument runs an Effect, which the call's thunk cannot hold.
function method() {
  const trace: string[] = []
  const codec = {
    get parse(): typeof JSON.parse | undefined {
      trace.push("getter")
      return undefined
    }
  }
  function input() {
    trace.push("argument")
    Effect.yieldNow()
    return "7"
  }
  const value = codec.parse?.(input())
  return [value ?? null, trace]
}

function receiver(codec: { parse: typeof JSON.parse } | undefined) {
  const trace: string[] = []
  function input() {
    trace.push("argument")
    Effect.yieldNow()
    return "7"
  }
  const value = codec?.parse(input())
  return [value ?? null, trace]
}

export function main() {
  return { method: method(), receiver: receiver(undefined), present: receiver(JSON) }
}
