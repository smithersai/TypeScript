// A function whose contract is an Effect is as stack-safe as its Effect.gen
// equivalent, even when it can neither fail nor pause: recursion through a
// call cycle starts eagerly, then continues on heap frames at the depth bound.
export function countdown(n: number): Effect<number> {
  if (n === 0) return 0
  return countdown(n - 1)
}

export function isEven(n: number): Effect<boolean> {
  if (n === 0) return true
  return isOdd(n - 1)
}

export function isOdd(n: number): Effect<boolean> {
  if (n === 0) return false
  return isEven(n - 1)
}

export function sumTo(n: number): Effect<number> {
  return n === 0 ? 0 : n + sumTo(n - 1)
}

// A plain caller outside the cycle still reads a number.
function deep(): number {
  return countdown(100000) + 1
}

// expect-result: {"countdown":0,"even":true,"odd":false,"sum":5000050000,"deep":1,"mapped":[0,0]}
export function main() {
  return {
    countdown: countdown(100000),
    even: isEven(100000),
    odd: isOdd(100000),
    sum: sumTo(100000),
    deep: deep(),
    mapped: [3, 100000].map((n) => countdown(n))
  }
}
