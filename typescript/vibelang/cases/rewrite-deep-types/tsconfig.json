{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "out",
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "types": [],
    "declaration": true
  },
  "include": [
    "*.vibe",
    "*.ts"
  ],
  "exclude": [
    "src/**/*.test.vibe"
  ],
  "vibelang": {
    "diagnostics": {
      "EK3205": "error"
    }
  }
}
