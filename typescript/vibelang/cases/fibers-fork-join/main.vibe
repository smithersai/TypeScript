// expect-result: {"pair":["Ada",3],"tuple":["Ada",3],"record":{"user":"Ada","count":3},"block":"done","old":"Ada","deferred":7,"failed":"NotFound","interrupted":true,"detached":"background","scoped":"scoped"}
error NotFound { id: string }

function getUser(id: string): string!NotFound! {
  sleep("5 millis")
  if (id === "missing") throw new NotFound({ id })
  return "Ada"
}

function count(): number!! {
  sleep("2 millis")
  return 3
}

function label(): string!! {
  return "scoped"
}

// fork starts a fiber; join joins it, and its failure joins E.
function pair() {
  const user = fork getUser("42")
  const n = fork count()
  return [join user, join n]
}

// join on an array joins every fiber and keeps the shape.
function tuple() {
  const [user, n] = join [fork getUser("42"), fork count()]
  return [user, n]
}

function record() {
  return join { user: fork getUser("42"), count: fork count() }
}

// fork { ... } forks a block.
function block() {
  const done = Deferred.make<string>()
  fork {
    sleep("1 millis")
    Deferred.succeed(done, "done")
  }
  return done.await()
}

// The call form still works.
function old() {
  const fiber = fork(getUser("42"))
  return join fiber
}

function deferred() {
  const d = Deferred.make<number>()
  Deferred.succeed(d, 7)
  return d.await()
}

function failed() {
  try {
    const user = fork getUser("missing")
    return join user
  } catch (e) {
    return e._tag
  }
}

// When one fiber fails, join interrupts the others.
function interrupted() {
  const slow = fork {
    sleep("1 second")
    return "slow"
  }
  const bad = fork getUser("missing")
  try {
    join [slow, bad]
    return false
  } catch (e) {
    // join has already interrupted slow, so Fiber.await returns at once.
    // A Fiber function keeps an owned fiber in its region; passing it to
    // another call, such as a hatch, would be EK4838 (D409).
    const exit = Fiber.await(slow)
    return Exit.isFailure(exit) && Cause.hasInterrupts(exit.cause)
  }
}

function detached() {
  const d = Deferred.make<string>()
  detach(Deferred.succeed(d, "background"))
  return d.await()
}

function scoped() {
  const scope = Scope.make()
  const fiber = forkIn(scope, label())
  const value = join fiber
  Scope.close(scope, Exit.void)
  return value
}

export function main() {
  return {
    pair: pair(),
    tuple: tuple(),
    record: record(),
    block: block(),
    old: old(),
    deferred: deferred(),
    failed: failed(),
    interrupted: interrupted(),
    detached: detached(),
    scoped: scoped()
  }
}
