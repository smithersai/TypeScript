// expect: EK4701
// A declaration file's class is a closed error declaration only when its
// declaration file marks it with the runtime's ErrorBrand, as the compiler
// writes one (D407). Expired has the shape of a compiled error, a tag and a
// private member, but no marker, so its arm removes nothing and the match
// needs a default arm. It compiled before.
import { Expired } from "legacy-errors"

error Gone { id: string }

export function describe(e: Expired | Gone): string {
  return match (e) {
    when Expired: "expired";
    when Gone: "gone";
  }
}
