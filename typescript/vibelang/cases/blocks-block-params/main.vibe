// expect-result: {"spanned":"ADA","timed":"in time","guarded":"guarded","appended":42,"method":"job:done","bare":"once","nested":"outer:inner"}
function getName(): string!! {
  return "Ada"
}

// An Effect dual takes its program first, or returns a function that takes
// it, so its program is an arrow: a block is the call's last argument (D376).
function spanned() {
  return withSpan(() => {
    const name = getName()
    return name.toUpperCase()
  }, "load")
}

function timed() {
  return timeout(() => {
    sleep("1 millis")
    return "in time"
  }, "1 second")
}

function guarded() {
  const semaphore = Semaphore.make(1)
  return semaphore.withPermits(1)(() => {
    return "guarded"
  })
}

// A function that takes the program as its last argument gets the block there.
function twice(label: string, program: () => number!!) {
  return label.length + program() + program()
}

function appended() {
  return twice("abcd") {
    return 19
  }
}

class Runner {
  run(name: string, program: () => string!!) {
    return `${name}:${program()}`
  }
}

function method() {
  const runner = new Runner()
  return runner.run("job") {
    return "done"
  }
}

// A name followed by a block passes the block as the only argument.
function once(program: () => string!!) {
  return program()
}

function bare() {
  return once {
    return "once"
  }
}

function nested() {
  return runnerOf().run("outer") {
    return once { return "inner" }
  }
}

function runnerOf() {
  return new Runner()
}

export function main() {
  return { spanned: spanned(), timed: timed(), guarded: guarded(), appended: appended(), method: method(), bare: bare(), nested: nested() }
}
