// expect: EK4701
// A class of a .vibe file that is not an error declaration is not closed
// (D428), so its arm removes nothing and the match needs a default arm. It
// compiled before.
class Point {
  constructor(readonly x: number) {}
}

export function describe(p: Point): string {
  return match (p) {
    when Point: "point";
  }
}
