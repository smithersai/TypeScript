// expect-result: ["Reader.list","Reader.fires"]
function list() {
  return withSpan(() => {
    yieldNow()
    return Effect.currentSpan().name
  }, "Reader.list")
}
const reader = {
  fires: () => withSpan(() => {
    yieldNow()
    return Effect.currentSpan().name
  }, "Reader.fires")
}
export function main() { return [list(), reader.fires()] }
