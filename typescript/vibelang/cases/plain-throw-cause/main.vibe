// A function that compiles to plain JavaScript throws a Cause as an Effect
// function does (D177, D54): its catch receives the cause's first expected
// failure with the cause's type, and a cause that holds a defect passes
// through the catch and stays a defect (D13). failed, died and mixed compile
// to plain JavaScript; framedDied, which yields, compiles to frames.
function failed() {
  try { throw Cause.fail("bad") }
  catch (e) { const message: string = e; return typeof message + ":" + message }
}

function died() {
  try { throw Cause.die("boom") }
  catch { return "caught" }
}

function mixed() {
  try { throw Cause.combine(Cause.fail("bad"), Cause.die("boom")) }
  catch { return "caught" }
}

function framedDied() {
  yieldNow()
  try { throw Cause.die("boom") }
  catch { return "caught" }
}

function described(outcome: Exit<string, never>): string {
  if (outcome is Exit.Success(let value)) return value
  const reason = outcome.cause.reasons[0]
  return reason._tag === "Die" ? "Die:" + String(reason.defect) : reason._tag
}

// expect-result: {"failed":"string:bad","died":"Die:boom","framedDied":"Die:boom","mixed":"Die:bad"}
export function main() {
  return {
    failed: failed(),
    died: described(exit(died())),
    framedDied: described(exit(framedDied())),
    mixed: described(exit(mixed()))
  }
}
