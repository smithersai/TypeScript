// A method whose parameters bind on every run (a default, a rest parameter
// or a parameter it writes) forwards its this and arguments to a generator
// that fnUntraced calls on each run. A nested Effect arrow that reads
// arguments reads that run's arguments object, not one shared by every run.
export class Counter {
  defaulted(a: number, step = 1): number!! {
    const bump = () => {
      const tick = Effect.sync(() => step)
      return arguments[0]++
    }
    return bump()
  }

  rest(...values: number[]): number!! {
    const bump = () => {
      const tick = Effect.sync(() => values.length)
      return arguments[0]++
    }
    return bump()
  }

  written(a: number): number!! {
    a += 0
    const bump = () => {
      const tick = Effect.sync(() => a)
      return arguments[0]++
    }
    return bump()
  }

  identity(a: number, step = 1) {
    const tick = Effect.sync(() => step)
    const read = () => {
      const next = Effect.sync(() => 0)
      return arguments
    }
    return read() === arguments
  }
}
