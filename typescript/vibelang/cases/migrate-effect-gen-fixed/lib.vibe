// vibelang --fix writes Effect.gen programs in direct style (D470). The
// migration renames this file to lib.vibe; migrate-effect-gen-fixed holds
// what --fix then writes, which main.ts runs with the same result, and
// whose declarations are the same (expected/lib.d.ts).
import { Gone, Users } from "./services.js"

// An arrow whose body is Effect.gen.
export const greet = (id: string) => {
  const users = Users()
  const name = users.find(id)
  return `Hello, ${name}`
}

// A function whose only statement returns Effect.gen.
export function count(n: number) {
  let total = 0
  for (let i = 1; i <= n; i++) total += Effect.succeed(i)
  return total
}

// A method that passes this as the generator's self.
export class Box {
  constructor(readonly value: number) {}
  doubled() {
    const value = Effect.succeed(this.value)
    return value * 2
  }
}

// An error instance that a yield* fails with.
export const check = (n: number) => {
  if (n < 0) throw new Gone({ id: n })
  return `ok ${n}`
}

// A callback that returns the program it builds.
export const doubleAll = (xs: ReadonlyArray<number>) => {
  return Effect.forEach(xs, (x) => x * 2)
}

// A program value that a yield* runs, and a template literal that keeps its lines.
export const describe = (program: number!!) => {
  const n = program()
  return `n=${n}
  done`
}

// A program where a layer takes one.
export const UsersLive = Layer.effect(
  Users,
  () => {
    const prefix = "user-"
    return { find: (id: string) => id === "1" ? "Ada" : prefix + id }
  },
)
