// expect: EK4701
// A class a .ts file declares is not closed, error or not (D428): a value of
// its type need not pass its instanceof test, so its arm removes nothing,
// and a match over it needs a default arm. Both compiled before and threw
// at run time for a structural Plain.
import { Plain } from "./ext.ts"

error NotFound { id: string }

export function mixed(x: NotFound | Plain): number {
  return match (x) {
    when NotFound: 1;
    when Plain: 2;
  }
}

export function alone(x: Plain): number {
  return match (x) {
    when Plain: 1;
  }
}
