// expect-result: {"all":["user 1",3],"record":{"user":"user 2","count":3},"held":["user 3",3],"failFast":"Boom","settled":["Success","Failure"],"race":"fast","raceFailure":"Boom","raceBlocks":"got user 4","any":"fast","deferred":"ready","tie":"a","raceDo":"got user 5","templates":["user 6!",3],"templateRace":"fast!"}
error Boom { n: number }

function getUser(id: string): string!! {
  sleep("5 millis")
  return `user ${id}`
}

function count(): number!! {
  sleep("2 millis")
  return 3
}

function slow(): string!! {
  sleep("1 second")
  return "slow"
}

function fast(): string!! {
  sleep("1 millis")
  return "fast"
}

function boom(): string!Boom! {
  sleep("1 millis")
  throw new Boom({ n: 1 })
}

// await.all starts each program in its own fiber and keeps the shape.
function all() {
  const [user, n] = await.all [getUser("1"), count()]
  return [user, n]
}

function record() {
  return await.all { user: getUser("2"), count: count() }
}

// A fiber already running is awaited, not restarted.
function held() {
  const user = fork getUser("3")
  return await.all [join user, count()]
}

// A failure interrupts the rest and propagates.
function failFast() {
  try {
    await.all [slow(), boom()]
    return "no"
  } catch (e) {
    return e._tag
  }
}

// await.allSettled never fails; each outcome is a Result.
function settled() {
  const outcomes = await.allSettled [count(), boom()]
  return (outcomes as ReadonlyArray<(typeof outcomes)[number]>).map((outcome) => outcome._tag)
}

// await.race: the first to finish wins, success or failure.
function race() {
  return await.race [slow(), fast()]
}

function raceFailure() {
  try {
    return await.race [slow(), boom()]
  } catch (e) {
    return e._tag
  }
}

function raceBlocks() {
  return await.race [
    do {
      sleep("1 second")
      "timeout"
    },
    do {
      const user = getUser("4");
      `got ${user}`
    }
  ]
}

// await.any: the first to succeed wins.
function anyWins() {
  return await.any [boom(), fast()]
}

function deferred() {
  const ready = Deferred.make<string>()
  Deferred.succeed(ready, "ready")
  return await.race [ready.await(), slow()]
}

// Of elements ready at once, the first written wins.
function tie() {
  return await.race [Effect.succeed("a"), Effect.succeed("b")]
}

// A do expression gives an element statements; it is passed by name.
function raceDo() {
  return await.race [
    do {
      sleep("1 second")
      "timeout"
    },
    do {
      const user = getUser("5")
      "got " + user
    }
  ]
}

// An element passed by name may be any expression that runs a program.
function templates() {
  const [user, n] = await.all [`${getUser("6")}!`, count()]
  return [user, n]
}

function templateRace() {
  return await.race [`${slow()}!`, `${fast()}!`]
}

export function main() {
  return {
    all: all(),
    record: record(),
    held: held(),
    failFast: failFast(),
    settled: settled(),
    race: race(),
    raceFailure: raceFailure(),
    raceBlocks: raceBlocks(),
    any: anyWins(),
    deferred: deferred(),
    tie: tie(),
    raceDo: raceDo(),
    templates: templates(),
    templateRace: templateRace()
  }
}
