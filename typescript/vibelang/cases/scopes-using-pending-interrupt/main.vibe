// using is Effect's acquireRelease of its initializer, with Effect's own
// interruptibility (D481). An initializer that does not require Scope runs
// masked, as Effect.acquireDisposable's acquire does, so an interruption that
// arrives while it runs lands once the value's release is registered, and the
// value is released: one that ends in its own mask ("ending"), one that waits
// ("waiting"), and one whose helper acquires an interruptible lock with a
// using of its own, which stays masked too ("nested"). An initializer that
// requires Scope is a scoped acquisition, which runs with the
// interruptibility in force where the using stands, as yield* runs it, so
// the interruption reaches its wait and nothing is acquired: a pause in it
// ("scoped") and an acquireRelease with { interruptible: true } behind a
// wrapper ("interruptible").
// expect-result: {"ending":["acquired","disposed"],"waiting":["acquired","disposed"],"nested":["locked","acquired","unlocked","disposed"],"scoped":[],"interruptible":[]}
export function main() {
  return { ending: endingInMask(), waiting: waiting(), nested: nested(), scoped: scoped(), interruptible: interruptible() }
}

function endingInMask() {
  const events: string[] = []
  const entered = Deferred.make<void>()
  const gate = Deferred.make<void>()

  function work() {
    using resource = Effect.uninterruptible(() => {
      Deferred.succeed(entered, undefined)
      Deferred.await(gate)
      events.push("acquired")
      return { [Symbol.dispose](): void { events.push("disposed") } }
    })
    events.push("body")
  }

  const child = Effect.forkChild(work())
  Deferred.await(entered)
  child.interruptUnsafe(98765)
  Deferred.succeed(gate, undefined)
  Fiber.await(child)
  return events
}

function waiting() {
  const events: string[] = []
  const entered = Deferred.make<void>()
  const gate = Deferred.make<void>()

  function open() {
    Deferred.succeed(entered, undefined)
    Deferred.await(gate)
    events.push("acquired")
    return { [Symbol.dispose](): void { events.push("disposed") } }
  }

  function work() {
    using resource = open()
    events.push("body")
  }

  const child = Effect.forkChild(work())
  Deferred.await(entered)
  child.interruptUnsafe(98765)
  Deferred.succeed(gate, undefined)
  Fiber.await(child)
  return events
}

function nested() {
  const events: string[] = []
  const entered = Deferred.make<void>()
  const gate = Deferred.make<void>()

  function lock() {
    return Effect.acquireRelease(
      () => {
        Deferred.succeed(entered, undefined)
        Deferred.await(gate)
        events.push("locked")
        return { held: true }
      },
      () => {
        events.push("unlocked")
      },
      { interruptible: true }
    )
  }

  // Its using supplies the lock's Scope, so open requires no Scope.
  function open() {
    using held = lock()
    events.push("acquired")
    return { [Symbol.dispose](): void { events.push("disposed") } }
  }

  function work() {
    using resource = open()
    events.push("body")
  }

  const child = Effect.forkChild(work())
  Deferred.await(entered)
  child.interruptUnsafe(98765)
  Deferred.succeed(gate, undefined)
  Fiber.await(child)
  return events
}

function scoped() {
  const events: string[] = []
  const entered = Deferred.make<void>()
  const gate = Deferred.make<void>()

  function open(): object!!Scope {
    Deferred.succeed(entered, undefined)
    Deferred.await(gate)
    events.push("acquired")
    return { [Symbol.dispose](): void { events.push("disposed") } }
  }

  function work() {
    using resource = open()
    events.push("body")
  }

  const child = Effect.forkChild(work())
  Deferred.await(entered)
  child.interruptUnsafe(98765)
  Deferred.succeed(gate, undefined)
  Fiber.await(child)
  return events
}

function interruptible() {
  const events: string[] = []
  const entered = Deferred.make<void>()
  const gate = Deferred.make<void>()

  function connect() {
    return Effect.acquireRelease(
      () => {
        Deferred.succeed(entered, undefined)
        Deferred.await(gate)
        events.push("acquired")
        return { socket: "open" }
      },
      () => {
        events.push("released")
      },
      { interruptible: true }
    )
  }

  function work() {
    using resource = connect()
    events.push("body")
  }

  const child = Effect.forkChild(work())
  Deferred.await(entered)
  child.interruptUnsafe(98765)
  Deferred.succeed(gate, undefined)
  Fiber.await(child)
  return events
}
