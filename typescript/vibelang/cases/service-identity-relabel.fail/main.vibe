// expect: EK2002 TS2322
// A service's identifier is nominal (D361): only a type that carries A's
// brand is A. Widening A's requirement to a structural type with A's members
// is allowed, but that type is not B either, so providing B leaves it in R
// and assigning it to a requirement of B is TS2322. Each program used to
// compile, and the first two died with "Service not found: …#A".
service A { value: number }
service B { value: number }
type Shape = { value: number }

function needsA(): number!!A { return A().value }

export function viaProvideService(): number!! {
  const p: Effect<number, never, Shape> = needsA()
  return Effect.provideService(p, B, { value: 2 })
}

export function viaProvideBlock(): number!! {
  const p: Effect<number, never, Shape> = needsA()
  provide B = { value: 2 } {
    return p()
  }
}

export function viaAssignment(): Effect<number, never, B> {
  const p: Effect<number, never, Shape> = needsA()
  const claimed: Effect<number, never, B> = p
  return claimed
}
