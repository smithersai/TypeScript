// expect: EK4301
import { Schema, SchemaTransformation } from "effect"
function double(n: number): number!! { return n * 2 }
export function main() {
  [1, 2].map(double)
  Schema.suspend((): Schema.Codec<string, string>!! => Schema.String)
  return SchemaTransformation.transform({
    decode: (text: string): ReadonlyArray<string>!! => text.split(";"),
    encode: (items: ReadonlyArray<string>) => items.join(";")
  })
}
