// expect: EK4402
/// <reference path="./node-types/index.d.ts" />
// D108, D310: each platform API names the Effect service that replaces it,
// which needs no import, and the layer that provides it. An API that Effect
// lacks names VibeLang's experimental service, never a wrapper module.
import * as path from "node:path"
import { execFileSync } from "node:child_process"
import { randomBytes } from "node:crypto"
import { hostname, tmpdir, uptime } from "node:os"
import { mkdtemp } from "node:fs/promises"

export const output = (name: string): infer _ => path.join("dist", name)
export const status = (): infer _ => execFileSync("git", ["status"])
export const page = (url: string): infer _ => fetch(url)
export const salt = (): infer _ => randomBytes(16)
export const here = (): infer _ => process.cwd()
export const scratch = (): infer _ => tmpdir()
export const workspace = (): infer _ => mkdtemp("build-")
export const machine = (): infer _ => hostname()
export const age = (): infer _ => uptime()
