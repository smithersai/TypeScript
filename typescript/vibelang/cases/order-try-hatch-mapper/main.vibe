// expect-result: [7,["mapper","input"]]
// A try hatch evaluates its arguments in the order written (chapter 13): the
// mapper before the inputs, though Effect.try takes the function that binds
// the inputs before the mapper.
error Bad { reason: unknown }

export function main() {
  const trace: string[] = []
  function makeMapper() {
    trace.push("mapper")
    return (reason: unknown) => new Bad({ reason })
  }
  function input() {
    trace.push("input")
    return 7
  }
  const value = try((x: number) => x, makeMapper(), input())
  return [value, trace]
}
