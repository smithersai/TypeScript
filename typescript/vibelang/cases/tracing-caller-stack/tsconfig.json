{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext",
      "dom"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "types": [],
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "outDir": "out"
  },
  "include": [
    "*.vibe",
    "*.ts"
  ],
  "vibelang": {
    "tracing": "all"
  }
}
