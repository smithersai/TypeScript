// expect-result: [false,true,200000,"ok"]
// Plain functions that call one another run as JavaScript until the eager
// budget is spent, then continue on heap frames through the function's
// Effect form. That call stands in a body that binds the function's
// parameters and declarations, so one spelled like the function, such as
// the parameter even of function even, must not replace the function.
function even(even: number): boolean!! { return even === 0 ? true : odd(even - 1) }
function odd(n: number): boolean!! { return n === 0 ? false : even(n - 1) }

function down(down: number): number!! { return down <= 0 ? 0 : 1 + up(down - 1) }
function up(n: number): number!! { return n <= 0 ? 0 : 1 + down(n - 1) }

function ping(n: number): string!! {
  const ping = "ok"
  return n <= 0 ? ping : pong(n - 1)
}
function pong(n: number): string!! { return ping(n - 1) }

export function main() {
  return [even(200001), odd(200001), down(200000), ping(200000)]
}
